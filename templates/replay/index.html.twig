{% extends 'base.html.twig' %}

{% block title %}Simulation de course - Bibliothèque Locale{% endblock %}

{% block body %}
<div class="mb-8 border-l-4 border-f1-red pl-4">
    <h2 class="text-2xl sm:text-3xl font-extrabold uppercase tracking-wide">
        Simulation de course
    </h2>
    <p class="text-gray-400 text-sm mt-1">
        Circuits locaux · Pilotes de <code class="text-f1-red">data/pilotes.json</code> · Incidents aléatoires et influences
    </p>
</div>

<div class="bg-f1-card p-4 sm:p-6 rounded-xl border border-f1-border mb-8 shadow-lg">
    <form method="GET" action="{{ path('app_replay') }}" id="sim-form" class="space-y-6">
        
        {# Grille Principale #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            
            {# Choix du Circuit #}
            <div>
                <label for="sim-circuit" class="block text-xs font-semibold text-gray-400 uppercase mb-2">
                    Circuit
                </label>
                <select name="circuit" id="sim-circuit" class="w-full bg-f1-dark border border-f1-border rounded-lg p-3 text-white focus:border-f1-red focus:outline-none">
                    {% for slug, circuit in circuits %}
                        <option value="{{ slug }}" {{ selected_circuit == slug ? 'selected' }}>
                            {{ circuit.name }} ({{ (circuit.length_m / 1000)|round(2) }} km)
                        </option>
                    {% endfor %}
                </select>
            </div>

            {# Tours #}
            <div>
                <label for="sim-laps" class="block text-xs font-semibold text-gray-400 uppercase mb-2">
                    Tours
                </label>
                <input type="number" id="sim-laps" name="laps" min="1" max="200" value="15" class="w-full bg-f1-dark border border-f1-border rounded-lg p-3 text-white focus:border-f1-red focus:outline-none">
            </div>

            {# Météo #}
            <div>
                <label for="sim-weather" class="block text-xs font-semibold text-gray-400 uppercase mb-2">
                    Météo
                </label>
                <select id="sim-weather" name="weather" class="w-full bg-f1-dark border border-f1-border rounded-lg p-3 text-white focus:border-f1-red focus:outline-none">
                    <option value="dry">Sec</option>
                    <option value="rain">Pluie</option>
                    <option value="random">Aléatoire</option>
                </select>
            </div>
        </div>

        {# Configuration des Incidents & Safety Car #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 border-t border-f1-border pt-4">
            <div>
                <label for="sim-chaos" class="block text-xs font-semibold text-gray-400 uppercase mb-2">
                    Chaos (incidents) : <span id="chaos-val">1.0</span>×
                </label>
                <input type="range" id="sim-chaos" name="chaos" min="0" max="4" step="0.1" value="1.0" class="w-full accent-f1-red" oninput="document.getElementById('chaos-val').textContent = this.value">
            </div>

            <div class="flex items-center pt-4">
                <label class="inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="safety_car" value="1" checked class="sr-only peer">
                    <div class="relative w-11 h-6 bg-f1-dark peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-f1-red"></div>
                    <span class="ms-3 text-sm font-medium text-gray-300">Safety Car</span>
                </label>
            </div>

            <div>
                <label for="sim-seed" class="block text-xs font-semibold text-gray-400 uppercase mb-2">
                    Graine (optionnel)
                </label>
                <input type="number" id="sim-seed" name="seed" placeholder="Aléatoire" class="w-full bg-f1-dark border border-f1-border rounded-lg p-3 text-white focus:border-f1-red focus:outline-none">
            </div>
        </div>

        {# Influences Avancées (Accordéon) #}
        <details class="border border-f1-border rounded-lg p-4 bg-f1-dark/40">
            <summary class="cursor-pointer text-sm font-semibold text-gray-300 uppercase">
                Influences avancées (événements forcés, modificateurs pilotes)
            </summary>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                <div>
                    <label for="sim-events" class="block text-xs font-semibold text-gray-400 mb-1">
                        Événements forcés (JSON) — types : <code class="text-xs text-f1-red">safety_car, puncture, mechanical, collision, spin, penalty</code>
                    </label>
                    <textarea id="sim-events" name="events" rows="3" placeholder='[{"lap": 5, "type": "safety_car"}]' class="w-full bg-f1-dark border border-f1-border rounded-lg p-2 text-xs font-mono text-white focus:border-f1-red focus:outline-none"></textarea>
                </div>
                <div>
                    <label for="sim-mods" class="block text-xs font-semibold text-gray-400 mb-1">
                        Modificateurs pilotes (JSON) — pace en s/tour (négatif = plus rapide), reliability (>1 = plus fiable)
                    </label>
                    <textarea id="sim-mods" name="mods" rows="3" placeholder='{"VER": {"pace": -0.3, "reliability": 1.2}}' class="w-full bg-f1-dark border border-f1-border rounded-lg p-2 text-xs font-mono text-white focus:border-f1-red focus:outline-none"></textarea>
                </div>
            </div>
        </details>

        {# Boutons d'Action #}
        <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <button type="submit" id="load-btn" class="flex-1 bg-f1-red hover:bg-red-700 text-white font-bold py-3 px-4 rounded-lg transition uppercase text-sm tracking-wider">
                Lancer la course
            </button>
            <a href="{{ path('app_replay', {demo: 1}) }}" class="bg-f1-dark hover:bg-f1-border text-gray-300 font-semibold py-3 px-4 rounded-lg transition text-center uppercase text-sm tracking-wider border border-f1-border">
                Circuit de démonstration (hors ligne, instantané)
            </a>
        </div>
    </form>

    <p id="loading" class="hidden text-sm text-gray-400 mt-4 text-center">
        Lancement de la simulation en cours...
    </p>
</div>

{% if error %}
    <div class="bg-red-950/50 border border-f1-red text-red-200 rounded-xl p-4 mb-8 text-sm">
        {{ error }}
    </div>
{% endif %}

<div class="bg-f1-card rounded-xl border border-f1-border overflow-hidden shadow-xl">
    <div class="px-4 sm:px-6 py-4 border-b border-f1-border">
        <h3 class="font-bold text-lg">Pilotes engagés</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-f1-dark text-gray-400 uppercase text-xs tracking-wider border-b border-f1-border">
                <tr>
                    <th class="py-3 px-4 sm:px-6">Pilote</th>
                    <th class="py-3 px-4 sm:px-6">Écurie</th>
                    <th class="py-3 px-4 sm:px-6">Nationalité</th>
                    <th class="py-3 px-4 sm:px-6">Points</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-f1-border">
                {% for driver in drivers %}
                    <tr class="hover:bg-f1-dark/50 transition">
                        <td class="py-3 px-4 sm:px-6 font-semibold whitespace-nowrap text-white">
                            {{ driver.name }}
                        </td>
                        <td class="py-3 px-4 sm:px-6 text-gray-300 whitespace-nowrap">{{ driver.display_team }}</td>
                        <td class="py-3 px-4 sm:px-6 text-gray-400 whitespace-nowrap">{{ driver.nationality ?? 'N/A' }}</td>
                        <td class="py-3 px-4 sm:px-6 font-mono text-gray-300">{{ driver.points ?? 0 }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="py-8 text-center text-gray-400">
                            Aucun pilote configuré dans <code class="text-f1-red">data/pilotes.json</code>.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
(function () {
    'use strict';
    var form = document.getElementById('sim-form');
    var button = document.getElementById('load-btn');
    var loading = document.getElementById('loading');

    form.addEventListener('submit', function () {
        loading.classList.remove('hidden');
        button.classList.add('opacity-50');
        button.disabled = true;
    });
})();
</script>
{% endblock %}
