{% extends 'base.html.twig' %}

{% block title %}Simulation de course{% endblock %}

{% block body %}
<div class="mb-6 border-l-4 border-f1-red pl-4">
    <h2 class="text-2xl sm:text-3xl font-extrabold uppercase tracking-wide">Simulation de course</h2>
    <p class="text-gray-400 text-sm mt-1">Circuits locaux · pilotes de data/pilotes.json · incidents aléatoires</p>
</div>

<div class="bg-f1-card p-4 sm:p-6 rounded-xl border border-f1-border mb-6 shadow-lg">
  <form id="sim-form" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label class="block text-xs font-semibold text-gray-400 uppercase mb-2">Circuit</label>
        <select name="circuit" class="w-full bg-f1-dark border border-f1-border rounded-lg p-3 text-white">
          {% for slug, c in circuits %}
            <option value="{{ slug }}" {{ selected_circuit == slug ? 'selected' }}>
              {{ c.name }}{% if c.length_m > 0 %} ({{ (c.length_m / 1000)|round(2) }} km){% endif %}
            </option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-400 uppercase mb-2">Tours</label>
        <input type="number" name="laps" min="1" max="200" value="15" class="w-full bg-f1-dark border border-f1-border rounded-lg p-3 text-white">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-400 uppercase mb-2">Météo</label>
        <select name="weather" class="w-full bg-f1-dark border border-f1-border rounded-lg p-3 text-white">
          <option value="dry">Sec</option><option value="rain">Pluie</option><option value="random">Aléatoire</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-400 uppercase mb-2">Graine (optionnel)</label>
        <input type="number" name="seed" class="w-full bg-f1-dark border border-f1-border rounded-lg p-3 text-white">
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-gray-400 uppercase mb-2">Chaos : <span id="chaos-val">1.0</span>×</label>
        <input type="range" name="chaos" min="0" max="4" step="0.1" value="1" class="w-full accent-f1-red"
               oninput="document.getElementById('chaos-val').textContent=this.value">
      </div>
      <label class="inline-flex items-center gap-2 text-sm text-gray-300 pt-6">
        <input type="checkbox" name="safety_car" checked> Safety Car
      </label>
    </div>
    <details class="border border-f1-border rounded-lg p-3">
      <summary class="cursor-pointer text-sm text-gray-300 uppercase">Influences avancées</summary>
      <div class="grid md:grid-cols-2 gap-4 mt-3">
        <textarea name="events" rows="3" placeholder='[{"lap":5,"type":"safety_car"}]' class="bg-f1-dark border border-f1-border rounded-lg p-2 text-xs font-mono text-white"></textarea>
        <textarea name="mods" rows="3" placeholder='{"VER":{"pace":-0.3,"reliability":1.2}}' class="bg-f1-dark border border-f1-border rounded-lg p-2 text-xs font-mono text-white"></textarea>
      </div>
    </details>
    <div class="flex gap-3">
      <button type="submit" id="run-btn" class="flex-1 bg-f1-red hover:bg-red-700 text-white font-bold py-3 rounded-lg uppercase text-sm">Lancer la course</button>
      <button type="button" id="demo-btn" class="border border-f1-border text-gray-300 py-3 px-4 rounded-lg uppercase text-sm">Circuit démo</button>
    </div>
  </form>
  <p id="status" class="text-sm text-gray-400 mt-3 min-h-5"></p>
</div>

<div id="viewer" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
  <div class="lg:col-span-2 bg-f1-card rounded-xl border border-f1-border p-3">
    <canvas id="track" class="w-full rounded-lg bg-f1-dark" style="aspect-ratio:4/3"></canvas>
    <div class="flex items-center gap-3 mt-3 text-sm text-gray-300">
      <button id="play" class="bg-f1-red px-4 py-2 rounded-lg font-bold">⏸</button>
      <input id="seek" type="range" min="0" value="0" class="flex-1 accent-f1-red">
      <select id="speed" class="bg-f1-dark border border-f1-border rounded p-2">
        <option value="1">×1</option><option value="4" selected>×4</option>
        <option value="10">×10</option><option value="30">×30</option>
      </select>
      <span id="clock" class="font-mono w-16 text-right">0:00</span>
    </div>
  </div>
  <div class="bg-f1-card rounded-xl border border-f1-border p-3">
    <h3 class="font-bold mb-2">Classement live <span id="lapinfo" class="text-xs text-gray-400"></span></h3>
    <ol id="board" class="text-sm font-mono space-y-1"></ol>
    <h3 class="font-bold mt-4 mb-2">Événements</h3>
    <ul id="events" class="text-xs text-gray-300 space-y-1 max-h-48 overflow-y-auto"></ul>
  </div>
</div>

<div id="results-box" class="hidden bg-f1-card rounded-xl border border-f1-border overflow-hidden mb-6">
  <div class="px-4 py-3 border-b border-f1-border font-bold">Résultats</div>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-f1-dark text-gray-400 uppercase text-xs">
        <tr><th class="p-3">Pos</th><th class="p-3">Pilote</th><th class="p-3">Écurie</th><th class="p-3">Grille</th><th class="p-3">Arrêts</th><th class="p-3">Statut</th><th class="p-3">Pts</th></tr>
      </thead>
      <tbody id="results" class="divide-y divide-f1-border"></tbody>
    </table>
  </div>
</div>

<script>
(function () {
  'use strict';
  var form = document.getElementById('sim-form');
  var statusEl = document.getElementById('status');
  var canvas = document.getElementById('track');
  var ctx = canvas.getContext('2d');
  var playBtn = document.getElementById('play');
  var seekEl = document.getElementById('seek');
  var speedEl = document.getElementById('speed');

  var data = null, geo = null, trackLayer = null;
  var t = 0;                 // temps de lecture, en "trames" (fractionnaire)
  var playing = true, dirty = false, forceBoard = true;
  var lastTs = 0, lastBoard = 0, dpr = 1, W = 0, H = 0;
  var cars = [], rows = [], resultsByCode = {};

  function setStatus(msg) { statusEl.textContent = msg; }

  function run(demo) {
    var fd = new FormData(form);
    var p = new URLSearchParams();
    fd.forEach(function (v, k) { if (k !== 'safety_car' && v !== '') p.append(k, v); });
    p.set('safety_car', form.elements.safety_car.checked ? '1' : '0');
    p.set('demo', demo ? '1' : '0');
    setStatus('Simulation en cours…');
    document.getElementById('run-btn').disabled = true;

    fetch('/api/replay/simulate?' + p.toString())
      .then(function (r) { return r.text().then(function (txt) {
        var j; try { j = JSON.parse(txt); } catch (e) { throw new Error('Réponse invalide : ' + txt.slice(0, 200)); }
        if (!r.ok || j.error) throw new Error(j.error || 'Erreur serveur');
        return j;
      }); })
      .then(function (j) { data = j; setup(); setStatus(''); })
      .catch(function (e) { setStatus('Erreur : ' + e.message); })
      .finally(function () { document.getElementById('run-btn').disabled = false; });
  }

  /* ---------- Données de la course (une fois par simulation) ---------- */
  function setup() {
    document.getElementById('viewer').classList.remove('hidden');

    resultsByCode = {};
    data.results.forEach(function (r) { resultsByCode[r.code] = r; });

    var framesByCode = {};
    data.frames.forEach(function (f) { framesByCode[f.code] = f; });
    cars = data.drivers.map(function (d) {
      return { d: d, fr: framesByCode[d.code], res: resultsByCode[d.code], dist: 0, x: 0, y: 0 };
    });

    // Lignes du classement : créées une seule fois
    var board = document.getElementById('board');
    board.textContent = '';
    rows = cars.map(function () {
      var li = document.createElement('li');
      li.className = 'flex items-center';
      var dot = document.createElement('span');
      dot.style.cssText = 'display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px';
      var name = document.createElement('span');
      var gap = document.createElement('span');
      gap.className = 'ml-auto text-gray-400';
      li.appendChild(dot); li.appendChild(name); li.appendChild(gap);
      board.appendChild(li);
      return { dot: dot, name: name, gap: gap };
    });

    var ev = document.getElementById('events'); ev.textContent = '';
    data.events.forEach(function (e) {
      var li = document.createElement('li');
      li.textContent = 'T' + e.lap + ' · ' + e.text;
      ev.appendChild(li);
    });

    var tb = document.getElementById('results'); tb.textContent = '';
    data.results.forEach(function (r) {
      var tr = document.createElement('tr');
      [r.position, r.code + ' ' + r.name, r.team, 'P' + r.grid, r.stops,
       r.status === 'DNF' ? 'DNF (' + (r.reason || '?') + ')' : (r.gap_s == null ? 'Vainqueur' : '+' + r.gap_s.toFixed(3) + ' s'),
       r.points].forEach(function (v) {
        var td = document.createElement('td'); td.className = 'p-3'; td.textContent = v; tr.appendChild(td);
      });
      tb.appendChild(tr);
    });
    document.getElementById('results-box').classList.remove('hidden');

    seekEl.max = data.race.frame_count - 1;
    seekEl.step = 'any';
    t = 0; playing = true; playBtn.textContent = '⏸';
    layout();
  }

  /* ---------- Géométrie + tracé pré-rendu (au chargement et au resize) ---------- */
  function layout() {
    if (!data) return;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = canvas.width = Math.round(canvas.clientWidth * dpr);
    H = canvas.height = Math.round(canvas.clientHeight * dpr);

    var c = data.circuit, xs = c.x, ys = c.y;
    var minX = Math.min.apply(null, xs), maxX = Math.max.apply(null, xs);
    var minY = Math.min.apply(null, ys), maxY = Math.max.apply(null, ys);
    var pad = 25 * dpr;
    var sc = Math.min((W - 2 * pad) / (maxX - minX || 1), (H - 2 * pad) / (maxY - minY || 1));
    var ox = (W - (maxX - minX) * sc) / 2, oy = (H - (maxY - minY) * sc) / 2;
    geo = {
      px: xs.map(function (v) { return ox + (v - minX) * sc; }),
      py: ys.map(function (v) { return H - (oy + (v - minY) * sc); }),
      s: c.s, L: c.length_m
    };

    // Le tracé ne change jamais : on le dessine une fois hors écran
    trackLayer = document.createElement('canvas');
    trackLayer.width = W; trackLayer.height = H;
    var g = trackLayer.getContext('2d');
    g.lineJoin = 'round'; g.lineCap = 'round';
    g.beginPath();
    geo.px.forEach(function (x, i) { i ? g.lineTo(x, geo.py[i]) : g.moveTo(x, geo.py[i]); });
    g.closePath();
    g.strokeStyle = '#2a2a35'; g.lineWidth = 11 * dpr; g.stroke();
    g.strokeStyle = '#555566'; g.lineWidth = 7 * dpr; g.stroke();
    g.beginPath(); g.arc(geo.px[0], geo.py[0], 4.5 * dpr, 0, 7);
    g.fillStyle = '#ffffff'; g.fill();

    dirty = true; forceBoard = true;
  }

  /* ---------- Position sur le tracé ---------- */
  function place(car, dist) {
    var L = geo.L, m = ((dist % L) + L) % L, s = geo.s, lo = 0, hi = s.length - 1;
    while (lo < hi - 1) { var mid = (lo + hi) >> 1; if (s[mid] <= m) lo = mid; else hi = mid; }
    var nxt = (lo + 1) % s.length;
    var span = ((nxt === 0 ? L : s[nxt]) - s[lo]) || 1, k = (m - s[lo]) / span;
    car.x = geo.px[lo] + (geo.px[nxt] - geo.px[lo]) * k;
    car.y = geo.py[lo] + (geo.py[nxt] - geo.py[lo]) * k;
  }

  /* ---------- Dessin (à chaque image) ---------- */
  function draw(now) {
    if (!data || !geo) return;
    var maxI = data.race.frame_count - 1;
    var i0 = Math.min(Math.floor(t), maxI);
    var i1 = Math.min(i0 + 1, maxI);
    var frac = i0 >= maxI ? 0 : t - i0;

    // Interpolation entre deux trames : mouvement continu
    for (var n = 0; n < cars.length; n++) {
      var c = cars[n], a = c.fr.d[i0], b = c.fr.d[i1];
      c.dist = a + (b - a) * frac;
      place(c, c.dist);
    }
    var ranked = cars.slice().sort(function (p, q) { return q.dist - p.dist; });

    ctx.drawImage(trackLayer, 0, 0);
    ctx.font = 'bold ' + (10 * dpr) + 'px sans-serif';
    ctx.lineWidth = 1.5 * dpr;
    // Le leader est dessiné en dernier (au-dessus)
    for (var k = ranked.length - 1; k >= 0; k--) {
      var o = ranked[k];
      ctx.beginPath(); ctx.arc(o.x, o.y, 5.5 * dpr, 0, 7);
      ctx.fillStyle = o.d.color; ctx.fill();
      ctx.strokeStyle = '#000'; ctx.stroke();
      ctx.fillStyle = '#fff';
      ctx.fillText(o.d.code, o.x + 8 * dpr, o.y - 6 * dpr);
    }

    seekEl.value = t;

    // Textes : seulement 5 fois par seconde (ou immédiatement si on déplace la barre)
    if (forceBoard || now - lastBoard > 200) {
      updateBoard(ranked, i0, maxI);
      lastBoard = now; forceBoard = false;
    }
  }

  function updateBoard(ranked, i0, maxI) {
    var leader = ranked[0], dt = data.race.frame_dt;

    // Temps écoulé depuis que le leader est passé là où se trouve la voiture o
    function gapTo(o) {
      var arr = leader.fr.d, target = o.dist, lo = 0, hi = i0;
      if (arr[hi] < target) return 0;
      while (lo < hi) {
        var mid = (lo + hi) >> 1;
        if (arr[mid] >= target) hi = mid; else lo = mid + 1;
      }
      return (i0 - lo) * dt;
    }

    ranked.forEach(function (o, i) {
      var r = rows[i];
      r.dot.style.background = o.d.color;
      r.name.textContent = (i + 1) + '. ' + o.d.code;
      var retired = o.res && o.res.status === 'DNF' && o.fr.d[i0] === o.fr.d[maxI];
      var lapsDown = Math.floor((leader.dist - o.dist) / geo.L);
      var txt;
      if (retired) txt = 'ABD';
      else if (i === 0) txt = 'Leader';
      else if (lapsDown >= 1) txt = '+' + lapsDown + ' T';
      else txt = '+' + gapTo(o).toFixed(1) + 's';
      r.gap.textContent = txt;
    });

    var lap = Math.min(data.race.laps, Math.max(1, Math.floor(leader.dist / geo.L) + 1));
    document.getElementById('lapinfo').textContent = '· Tour ' + lap + '/' + data.race.laps;
    var sec = t * dt;
    document.getElementById('clock').textContent =
      Math.floor(sec / 60) + ':' + String(Math.floor(sec % 60)).padStart(2, '0');
  }

  /* ---------- Boucle d'animation ---------- */
  function loop(ts) {
    var delta = Math.min((ts - lastTs) / 1000, 0.1); // évite les sauts (onglet inactif)
    lastTs = ts;
    if (data && playing) {
      var maxI = data.race.frame_count - 1;
      t += delta * Number(speedEl.value) / data.race.frame_dt;
      if (t >= maxI) { t = maxI; playing = false; playBtn.textContent = '▶'; forceBoard = true; }
      dirty = true;
    }
    if (dirty) { dirty = false; draw(ts); }
    requestAnimationFrame(loop);
  }

  form.addEventListener('submit', function (e) { e.preventDefault(); run(false); });
  document.getElementById('demo-btn').addEventListener('click', function () { run(true); });
  playBtn.addEventListener('click', function () {
    if (!data) return;
    if (t >= data.race.frame_count - 1) t = 0;   // relance depuis le début
    playing = !playing;
    playBtn.textContent = playing ? '⏸' : '▶';
  });
  seekEl.addEventListener('input', function () { t = Number(this.value); dirty = true; forceBoard = true; });
  window.addEventListener('resize', function () { layout(); });
  requestAnimationFrame(loop);
})();
</script>
