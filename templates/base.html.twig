<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}F1 Simulator{% endblock %}</title>
    
    <!-- PWA Meta Tags & Manifest -->
    <link rel="manifest" href="{{ asset('manifest.json') }}">
    <meta name="theme-color" content="#e10600">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="F1 Simulator">
    <link rel="apple-touch-icon" href="https://upload.wikimedia.org/wikipedia/commons/3/33/F1.svg">
    <link rel="icon" type="image/svg+xml" href="https://upload.wikimedia.org/wikipedia/commons/3/33/F1.svg">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        f1: {
                            red: '#e10600',
                            dark: '#15151e',
                            card: '#1f1f27',
                            border: '#38383f'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #15151e; color: #fff; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
    <nav class="bg-f1-card border-b border-f1-border px-4 sm:px-6 py-4 flex justify-between items-center">
        <a href="{{ path('app_home') }}" class="flex items-center gap-3">
            <span class="bg-f1-red text-white font-black px-3 py-1 rounded text-xl italic tracking-wider">F1</span>
            <span class="text-xl font-bold tracking-tight">SIMULATOR</span>
        </a>
        <div class="flex items-center gap-4 text-sm">
            <a href="{{ path('app_seasons') }}" class="text-gray-300 hover:text-white">Saisons</a>
            <a href="{{ path('app_import') }}" class="text-gray-300 hover:text-white">Imports JSON</a>
            <a href="{{ path('app_replay') }}" class="text-gray-300 hover:text-white">Simulation</a>
            <a href="{{ path('app_simulator') }}" class="text-gray-300 hover:text-white">Résultats FastF1</a>
        </div>
    </nav>

    <main class="flex-1 container mx-auto p-4 sm:p-6">
        {% block body %}{% endblock %}
    </main>

    <footer class="text-center text-xs text-gray-500 py-4 border-t border-f1-border">
        F1 Simulator
    </footer>

    <!-- PWA Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then((reg) => console.log('PWA Service Worker enregistré avec succès :', reg.scope))
                    .catch((err) => console.error('Erreur d\'enregistrement du Service Worker :', err));
            });
        }
    </script>
</body>
</html>